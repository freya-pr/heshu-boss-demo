flowchart LR
    A["渠道/API/Webhook/文件导入"] --> B["建立接入任务"]
    B --> C["字段校验与标准化"]
    C --> D["幂等去重与来源归因"]
    D --> E["创建线索主档与来源快照"]

    E --> F1["分配处理"]
    E --> F2["身份与手机号处理"]
    E --> F3["订单同步处理"]

    F1 --> G1{"分配方式"}
    G1 --> G11["人工指定"]
    G1 --> G12["轮询"]
    G11 --> H1["负责人及员工活码"]
    G12 --> H1

    F2 --> G2{"是否已有可用手机号"}
    G2 -- "是" --> H2["标记已解密/无需解密"]
    G2 -- "否" --> I2["发起解密或导入结果"]
    I2 --> H2

    F3 --> G3["按来源单号同步订单"]
    G3 --> H3["保存订单及支付状态"]

    H1 --> J{"是否满足触达条件"}
    H2 --> J
    J -- "有负责人且有可触达身份" --> K["短信/活码/SOP触达"]
    J -- "条件不足" --> J1["保持相应待办并持续补偿"]
    K --> L["客户点击或扫码加微"]
    L --> M["企微/第三方事件回写"]
    M --> N["手机号或UnionID匹配客户"]
    N --> O{"身份是否冲突"}
    O -- "否" --> P["创建或关联唯一客户档案"]
    O -- "是" --> Q["阻断自动建档并生成撞单案件<br/>进入客户中心—撞单管理"]
    P --> R["发送并回收问卷"]
    R --> S["问卷完成与SABC定级"]
    S --> T["预约并完成测评"]
    T --> U["持续跟进与订单转化"]
    H3 --> U
    U --> V{"正式课转化规则是否命中"}
    V -- "是" --> W["转化状态=已转化"]
    V -- "否" --> X["转化状态=未转化"]

    C -. "字段异常" .-> Z["异常中心"]
    D -. "重复或幂等冲突" .-> Z
    I2 -. "解密失败" .-> Z
    G3 -. "订单同步失败" .-> Z
    M -. "事件无法关联" .-> Z
