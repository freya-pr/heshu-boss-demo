flowchart TD
    A["向已关联线索/客户发送问卷"] --> B["客户提交答卷"]
    B --> C{"答卷是否有效且唯一关联"}
    C -- "否" --> X["待关联 / 解析失败 / 异常处理"]
    C -- "是" --> D["读取适用的已发布等级规则版本"]
    D --> E["计算总分、维度分和必要条件"]
    E --> F["生成自动评级历史"]
    F --> G{"线索是否有生效人工等级"}
    G -- "是" --> H["仅保存自动候选，不覆盖人工等级"]
    G -- "否" --> I["更新线索当前等级S/A/B/C或未定级"]
    I --> J{"客户建档结果"}
    J -- "首次创建新客户" --> K["客户继承线索当前等级"]
    J -- "关联存量客户" --> L["保留客户原等级并记录差异候选"]
    K --> M["记录预约 / 到课 / 完课事实"]
    L --> M
    M --> N{"正式课程有效支付是否命中转化规则"}
    N -- "否" --> O["未转化，继续培育"]
    N -- "是" --> P["已转化"]
    P --> Q{"退款是否命中回退规则"}
    Q -- "是" --> O
    Q -- "否" --> R["保持已转化"]
