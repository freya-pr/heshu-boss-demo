flowchart TD
    A["有效线索进入分配处理"] --> B{"分配方式"}
    B -- "人工指定" --> C["按公司/部门/小组搜索员工"]
    C --> D{"员工是否在职且账号启用"}
    D -- "否" --> X["禁止分配"]
    D -- "是" --> E["直接指定负责人"]
    B -- "自动轮询" --> F["按营期、IP及可选外部班级匹配活码"]
    F --> G["读取最新生效的活码人员名单"]
    G --> H{"是否存在可接待员工"}
    H -- "否" --> Y["保持待分配并进入异常中心"]
    H -- "是" --> I["按稳定游标轮询并校验接量上限"]
    I --> J["选中接待员工"]
    E --> K["保存负责人、组织和分配历史"]
    J --> K
