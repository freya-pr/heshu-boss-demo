flowchart TD
    A["管理员选择一个或多个已授权平台"] --> B["按勾选顺序创建独立同步任务"]
    B --> C["平台API / Webhook / 定时拉取"]
    C --> D["保存原始报文摘要与来源标识"]
    D --> E{"必要字段是否合法"}
    E -- "否" --> X["接入异常：记录原因并可重试"]
    E -- "是" --> F["标准化平台、店铺、订单、商品、手机号等字段"]
    F --> G{"技术幂等键是否已存在"}
    G -- "是" --> H["更新原记录和同步时间，不新建"]
    G -- "否" --> I["创建内部线索主记录"]
    H --> J{"是否与其他业务线索重复"}
    I --> J
    J -- "有效" --> K["线索标记=有效"]
    J -- "无效" --> L["线索标记=无效，记录原因"]
    J -- "重复" --> M["线索标记=重复，关联主记录"]
