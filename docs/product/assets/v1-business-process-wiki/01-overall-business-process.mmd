flowchart LR
    subgraph PREPARE["0. 业务与系统配置"]
        P1["组织 / 员工 / 岗位 / 角色"]
        P2["营期 / 字典 / 系统参数"]
        P3["渠道 / 店铺 / 商品 / IP配置"]
        P4["活码 / 分配规则 / 等级规则 / 短信配置"]
    end

    subgraph ACCESS["1. 线索接入与治理"]
        A1["平台API / Webhook / 拉取任务"]
        A2["建立同步任务与原始快照"]
        A3["字段校验 / 标准化 / 幂等"]
        A4{"有效性与重复判断"}
        A5["有效线索主档"]
        A6["无效线索"]
        A7["重复线索关联主记录"]
    end

    subgraph PROCESS["2. 并行处理与归因"]
        B1["平台→店铺→商品→IP→IP渠道→IP大类"]
        B2["手机号解密或导入解密结果"]
        B3["同步订单 / 支付 / 退款事实"]
        B4["人工指定或活码名单轮询"]
        B5["固化负责人 / 组织 / 营期归因快照"]
    end

    subgraph OPERATE["3. 触达与客户建档"]
        C1{"负责人和可触达身份是否齐备"}
        C2["短信 / 活码 / 外部SOP触达"]
        C3["扫码 / 点击 / 加微事件回写"]
        C4["手机号或UnionID客户匹配"]
        C5{"是否跨客户身份冲突"}
        C6["创建或关联唯一客户"]
        C7["生成撞单案件并人工裁决"]
    end

    subgraph CONVERT["4. 培育与转化"]
        D1["发送并回收问卷"]
        D2["自动计算线索S/A/B/C等级"]
        D3["新客户首次建档继承线索等级"]
        D4["预约 / 到课 / 完课"]
        D5{"正式课程有效支付是否命中规则"}
        D6["转化状态=已转化"]
        D7["转化状态=未转化，继续培育"]
        D8{"是否发生满足回退条件的退款"}
    end

    subgraph ANALYZE["5. 数据分析与复盘"]
        E1["系统处理：接入 / 清洗 / 解密 / 分配"]
        E2["过程漏斗：短信 / 加微 / 问卷 / 预约 / 到课 / 完课"]
        E3["结果经营：成交 / 退款 / 转化率 / GMV"]
        E4["渠道 / 店铺 / 商品 / IP / 营期 / 组织下钻"]
    end

    EX["异常中心：重试 / 补录 / 对账 / 人工结案"]

    P1 -. "提供组织与权限" .-> A1
    P2 -. "提供营期和基础字典" .-> A3
    P3 -. "提供来源和归因主数据" .-> B1
    P4 -. "提供分配与经营规则" .-> B4
    A1 --> A2 --> A3 --> A4
    A4 -- "有效" --> A5
    A4 -- "无效" --> A6
    A4 -- "重复" --> A7
    A5 --> B1
    A5 --> B2
    A5 --> B3
    A5 --> B4
    B1 --> B5
    B4 --> B5
    B2 --> C1
    B5 --> C1
    C1 -- "否" --> EX
    C1 -- "是" --> C2 --> C3 --> C4 --> C5
    C5 -- "否" --> C6
    C5 -- "是" --> C7 --> C6
    C6 --> D1 --> D2 --> D3 --> D4 --> D5
    B3 --> D5
    D5 -- "否" --> D7
    D5 -- "是" --> D6 --> D8
    D8 -- "满足回退" --> D7
    D8 -- "不回退" --> E3
    A2 -. "接入失败" .-> EX
    A3 -. "校验失败" .-> EX
    B2 -. "解密失败" .-> EX
    B3 -. "同步失败" .-> EX
    B4 -. "无人可分" .-> EX
    C3 -. "事件无法关联" .-> EX
    D2 -. "评级失败" .-> EX
    A5 --> E1
    C3 --> E2
    D4 --> E2
    D6 --> E3
    E1 --> E4
    E2 --> E4
    E3 --> E4
